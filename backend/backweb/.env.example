PORT=3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=backweb_db
DB_USER=postgres
DB_PASSWORD=

# Entorno (development | production)
NODE_ENV=development

# JWT - Doble token
# Access token: vida corta, viaja en memoria del cliente
JWT_ACCESS_SECRET=cambia_este_secreto_access_por_uno_largo_y_aleatorio
JWT_ACCESS_EXPIRES=15m
# Refresh token: vida larga, viaja en cookie HttpOnly y es rotativo
JWT_REFRESH_SECRET=cambia_este_secreto_refresh_por_uno_distinto_y_aleatorio
JWT_REFRESH_EXPIRES=7d

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10
